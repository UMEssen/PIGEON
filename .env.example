# ──────────────────────────────────────────────
# PIGEON Pipeline Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# FHIR cache location (where extracted FHIR CSVs are stored)
FHIR_CACHE_BASE=/path/to/fhir_cache

# Lookup tables directory (ICD-10-GM, OPS, ATC CSVs)
LOOKUPS_DIR=/path/to/lookups

# Dataset output directory
DATASETS_DIR=/path/to/datasets

# Model storage directory
MODELS_DIR=/path/to/models
HF_CACHE_DIR=/path/to/hf_cache

# Results directory
RESULTS_DIR=/path/to/results

# ──── Database (for Stage 1: FHIR cache generation) ────
METRICS_DB=fhir_metrics
METRICS_USER=your_db_user
METRICS_PASSWORD=your_db_password
METRICS_HOST=localhost
METRICS_PORT=5432

# ──── LLM Endpoints (vLLM OpenAI-compatible API) ────
# Primary: used for text generation (e.g., Llama 3.3 70B)
LLM_ENDPOINT_PRIMARY=http://localhost:8000/v1
LLM_MODEL_PRIMARY=meta-llama/Llama-3.3-70B-Instruct

# Secondary: used for anamnese/epikrise generation (e.g., Qwen 3 235B)
LLM_ENDPOINT_SECONDARY=http://localhost:8001/v1
LLM_MODEL_SECONDARY=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8

# Inference: used for fine-tuned model inference
LLM_ENDPOINT_INFERENCE=http://localhost:8002/v1
LLM_MODEL_INFERENCE=google/medgemma-27b-text-it

# ──── HuggingFace ────
HF_TOKEN=hf_your_token_here

# ──── Processing ────
MAX_CONCURRENT_REQUESTS=10
BATCH_SIZE=32
